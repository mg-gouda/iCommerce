NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
# "Storefront" publishable key from `seed-defaults` (Retail + Wholesale channels: browse everything; B2B-only products are quote-only)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
# Server-only. Retail sales_channel id from `seed-defaults` → every new cart (cartSalesChannel() in lib/cart-actions.ts)
RETAIL_SALES_CHANNEL_ID=
# Server-only. Meilisearch *search* key (GET /keys → "Default Search API Key"); never the master key.
MEILI_HOST=http://localhost:7700
MEILI_SEARCH_KEY=
# Vendor portal base URL ("Sell on iCommerce" link)
NEXT_PUBLIC_VENDOR_PORTAL_URL=http://localhost:3001
# Same index name as the backend MEILI_INDEX (default products)
MEILI_INDEX=products
