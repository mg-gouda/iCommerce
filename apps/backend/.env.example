DATABASE_URL=postgres://postgres:postgres@localhost:5432/icommerce
# Unset → Medusa in-memory event bus / cache / workflow engine / locking (dev + tests only).
REDIS_URL=redis://localhost:6379
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
VENDOR_CORS=http://localhost:3001
AUTH_CORS=http://localhost:3000,http://localhost:3001,http://localhost:9000
# Generate real values for any shared environment: openssl rand -hex 32
JWT_SECRET=change-me
COOKIE_SECRET=change-me
# Unset MEILI_HOST → search sync disabled (no-op).
MEILI_HOST=http://localhost:7700
MEILI_KEY=dev-master-key-change-me
# Integration tests create throwaway DBs on this server.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
STOREFRONT_URL=http://localhost:3000
# This server's own externally-reachable URL; local file provider bakes it into upload URLs. Unset → localhost:9000.
BACKEND_URL=http://localhost:9000
